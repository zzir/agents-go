    "dompurify": "3.4.11",
    "highlight.js": "11.11.1",
    "katex": "0.16.47",
    "marked": "15.0.12",
    "mermaid": "11.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/dompurify": "3.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
